<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivModuleIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_module"
                android:contentDescription="@string/module_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvModuleName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Module Name"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvModulePackage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="com.example.module"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <TextView
                    android:id="@+id/tvModuleStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Enabled"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpenModuleApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Open module app"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnForceStopScoped"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Force stop scope"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Scope section -->
        <TextView
            android:id="@+id/tvScopeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Scope (0 apps)"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScopeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No apps scoped"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnLaunchScopedApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Launch scoped app under ShizuPosed"
            android:textAllCaps="false"
            android:enabled="false" />

        <Button
            android:id="@+id/btnEditScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Edit scope"
            android:textAllCaps="false"
            style="?attr/materialButtonOutlinedStyle" />

        <!-- Uninstall -->
        <Button
            android:id="@+id/btnUninstallModule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Uninstall module"
            android:textAllCaps="false"
            android:backgroundTint="?attr/colorError"
            android:textColor="?attr/colorOnError" />
    </LinearLayout>
</ScrollView>