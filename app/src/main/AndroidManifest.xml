<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        FGS type changed from dataSync to specialUse.
        Android 15 forbids dataSync FGS from BOOT_COMPLETED. specialUse is
        the correct type for a privileged hooking/service-manager that does
        not fit one of the narrow categories (dataSync, mediaPlayback, etc.).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for BootReceiver to fire. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- WorkManager needs this on some ROMs for expedited work, harmless otherwise. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Shizuku Permission -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
        QUERY_ALL_PACKAGES
        Required on some OEM ROMs (OPPO, older Xiaomi) that do not honor
        the intent-based <queries> block for getInstalledApplications().
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <provider android:authorities="com.shizuposed.manager.status" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
        NOTE ON ModuleStatusProvider ACCESS

        The provider is intentionally world-readable. It exposes only:
          • whether a module is enabled (user preference)
          • whether a module has loaded into at least one target process
          • which target packages a module has loaded into
          • framework name / version / enabled-module count

        None of that is sensitive, and modules that display "Activated"
        in their own UI must be able to query it from their own process
        under their own signing key. A signature-level permission on the
        provider blocks exactly that use case, because modules are never
        signed with ShizuPosed's key.

        LSPosed takes the same approach for its activation-query path.
    -->

    <application
        android:name=".ShizuPosedManagerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShizuPosedManager"
        android:resizeableActivity="true"
        tools:targetApi="37">

        <!-- Shizuku Provider -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            ModuleStatusProvider

            Exported and world-readable so module UIs in their own
            processes can query their own activation state. Read-only:
            insert/update/delete throw UnsupportedOperationException in
            ModuleStatusProvider. grantUriPermissions is left enabled so
            the manager can hand out read grants via Intent if it ever
            needs to (it does not currently).
        -->
        <provider
            android:name=".status.ModuleStatusProvider"
            android:authorities="com.shizuposed.manager.status"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ShizuPosedManager"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ShizuPosedService

            foregroundServiceType changed:
              dataSync  →  specialUse

            Android 15 forbids starting a dataSync FGS from BOOT_COMPLETED
            (this was the crash: "FGS type dataSync not allowed to start
            from BOOT_COMPLETED"). specialUse is permitted at boot subject
            to the general background-start rules, and it is the correct
            semantic type for this service.

            The <property> tag is REQUIRED for specialUse on Android 14+.
        -->
        <service
            android:name=".service.ShizuPosedService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Privileged Shizuku-backed hooking and module deployment service" />
        </service>

        <!--
            Boot Receiver.

            Kept android:enabled="false" — the receiver only does work if
            you explicitly enable it at runtime (via PackageManager) and
            the user has opted in to auto-start.

            It no longer calls startForegroundService() directly. Instead
            it enqueues a WorkManager job that retries until the platform
            allows the FGS start (which on Android 15 is often only after
            the app has been foregrounded at least once).
        -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>